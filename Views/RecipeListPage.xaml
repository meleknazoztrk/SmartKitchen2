<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartKitchen.ViewModels"
             xmlns:models="clr-namespace:SmartKitchen.Models"
             x:Class="SmartKitchen.Views.RecipeListPage"
             Title="Keşfet">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="15" RowSpacing="15">

        <!-- Auth Area -->
        <Grid Grid.Row="0" HorizontalOptions="End" VerticalOptions="Center" Margin="0,5,0,0">

            <!-- Giriş yapılmamış: Link göster -->
            <Label Text="🔑 Giriş Yap / Kaydol"
                   TextColor="#00FF88" FontSize="13" FontAttributes="Bold"
                   IsVisible="{Binding IsNotLoggedIn}"
                   HorizontalOptions="End" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToAuthCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Giriş yapılmış: Hoşgeldin göster -->
            <Label Text="{Binding CurrentUsername, StringFormat='👋 Hoşgeldin {0} ›'}"
                   TextColor="#00FF88" FontSize="13" FontAttributes="Bold"
                   IsVisible="{Binding IsLoggedIn}"
                   HorizontalOptions="End" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToProfileCommand}" />
                </Label.GestureRecognizers>
            </Label>

        </Grid>

        <!-- Search and Filters -->
        <SearchBar Grid.Row="1" Placeholder="Tarif ara..." Text="{Binding SearchText}" />

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="15">
            <Picker Grid.Column="0" Title="Süre" ItemsSource="{Binding TimeFilters}" SelectedItem="{Binding SelectedTimeFilter}" />
            <Picker Grid.Column="1" Title="Kalori" ItemsSource="{Binding CalorieFilters}" SelectedItem="{Binding SelectedCalorieFilter}" />
        </Grid>

        <!-- Recipes List -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Recipes}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RecipeMatchResult">
                    <Border StrokeShape="RoundRectangle 20" StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:RecipeListViewModel}}, Path=RecipeSelectedCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" Padding="15" ColumnSpacing="15">
                            
                            <!-- Match Percentage Circle -->
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 35" WidthRequest="70" HeightRequest="70" 
                                    BackgroundColor="{StaticResource BgDark}" Stroke="{StaticResource NeonGreen}" StrokeThickness="3">
                                <Label Text="{Binding MatchPercentage, StringFormat='{0:F0}%'}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource NeonGreen}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>

                            <StackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                                <Label Text="{Binding Recipe.Title}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Recipe.Description}" FontSize="12" TextColor="{StaticResource TextMuted}" LineBreakMode="TailTruncation" MaxLines="2" />
                                
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="15" Margin="0,5,0,0">
                                    <Label Grid.Column="0" Text="{Binding Recipe.PrepTimeMinutes, StringFormat='⏱ {0} dk'}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                    <Label Grid.Column="1" Text="{Binding Recipe.Calories, StringFormat='🔥 {0} kcal'}" FontSize="12" TextColor="{StaticResource TextMuted}" />
                                </Grid>
                            </StackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Add Own Recipe -->
        <Button Grid.Row="4" Text="Kendi Tarifini Ekle" Command="{Binding AddOwnRecipeCommand}" />
        
    </Grid>

</ContentPage>
