<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartKitchen.Views.OnboardingPage"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#121212">

    <Grid RowDefinitions="*,Auto,Auto" Padding="0">

        <!-- Orta Alan: Sol Ok | İçerik | Sağ Ok -->
        <Grid Grid.Row="0" ColumnDefinitions="64,*,64">

            <!-- Sol Ok -->
            <Button Grid.Column="0"
                    Text="‹"
                    Command="{Binding PreviousCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource PrimaryColor}"
                    FontSize="42"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="0"
                    Margin="0" />

            <!-- İçerik Alanı -->
            <StackLayout Grid.Column="1"
                         VerticalOptions="Center"
                         HorizontalOptions="Center"
                         Spacing="24"
                         Padding="10,40">

                <!-- Emoji -->
                <Label Text="{Binding CurrentEmoji}"
                       FontSize="96"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />

                <!-- Başlık -->
                <Label Text="{Binding CurrentTitle}"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource PrimaryColor}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />

                <!-- Açıklama -->
                <Label Text="{Binding CurrentDescription}"
                       FontSize="15"
                       TextColor="#A0A0A0"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       Margin="10,0" />

            </StackLayout>

            <!-- Sağ Ok -->
            <Button Grid.Column="2"
                    Text="›"
                    Command="{Binding NextCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource PrimaryColor}"
                    FontSize="42"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="0"
                    Margin="0" />

        </Grid>

        <!-- Nokta Göstergesi -->
        <HorizontalStackLayout Grid.Row="1"
                               HorizontalOptions="Center"
                               Spacing="10"
                               Margin="0,10">
            <BoxView WidthRequest="10" HeightRequest="10"
                     CornerRadius="5"
                     Color="{Binding Dot0Color}" />
            <BoxView WidthRequest="10" HeightRequest="10"
                     CornerRadius="5"
                     Color="{Binding Dot1Color}" />
            <BoxView WidthRequest="10" HeightRequest="10"
                     CornerRadius="5"
                     Color="{Binding Dot2Color}" />
        </HorizontalStackLayout>

        <!-- Başlat Butonu -->
        <Button Grid.Row="2"
                Text="Hadi Başlayalım 🚀"
                Command="{Binding StartAppCommand}"
                BackgroundColor="{DynamicResource PrimaryColor}"
                TextColor="#121212"
                FontAttributes="Bold"
                FontSize="17"
                CornerRadius="18"
                HeightRequest="54"
                Margin="30,10,30,40" />

    </Grid>

</ContentPage>
