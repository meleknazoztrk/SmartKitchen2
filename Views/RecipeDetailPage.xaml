<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartKitchen.ViewModels"
             xmlns:models="clr-namespace:SmartKitchen.Models"
             x:Class="SmartKitchen.Views.RecipeDetailPage"
             Title="Yemek Detayı"
             BackgroundColor="{StaticResource BgDark}">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">
            
            <!-- Close Button -->
            <Button Text="✕" FontSize="18" WidthRequest="40" HeightRequest="40" 
                    HorizontalOptions="End" VerticalOptions="Start" Padding="0" 
                    BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}"
                    Command="{Binding CloseCommand}" />

            <!-- Title & Basic Info -->
            <StackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="{Binding Recipe.Title}" FontSize="26" FontAttributes="Bold" 
                       HorizontalOptions="Center" HorizontalTextAlignment="Center" 
                       TextColor="{StaticResource TextLight}" />

                <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center" Margin="0,5,0,0">
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource CardDark}" Padding="12,6"
                            IsVisible="{Binding HasPortionSize}">
                        <Label Text="{Binding PortionSizeDisplay}" FontSize="13" TextColor="{DynamicResource PrimaryColor}" />
                    </Border>
                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource CardDark}" Padding="12,6"
                            IsVisible="{Binding HasCalories}">
                        <Label Text="{Binding CalorieDisplay}" FontSize="13" TextColor="{DynamicResource PrimaryColor}" />
                    </Border>
                </StackLayout>
            </StackLayout>

            <!-- Automatic Search & Redirection Buttons -->
            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{StaticResource NeonGreenTransparent}" 
                    BackgroundColor="{StaticResource CardDark}" Padding="16">
                <StackLayout Spacing="12">
                    <Label Text="Detaylı Tarif &amp; Videolu Anlatım" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextLight}" />
                    <Label Text="Tarifin tam yapılış adımlarını ve püf noktalarını izleyin veya okuyun:" FontSize="13" TextColor="{StaticResource TextMuted}" />

                    <!-- YouTube Button -->
                    <Button Text="▶ YouTube'da İzle" 
                            Command="{Binding OpenYouTubeCommand}"
                            BackgroundColor="#E62117" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="14" 
                            HeightRequest="48"
                            Margin="0,4,0,0" />

                    <!-- Nefis Yemek Tarifleri Button -->
                    <Button Text="📖 Nefis Yemek Tarifleri'nde Gör" 
                            Command="{Binding OpenNefisYemekTarifleriCommand}"
                            BackgroundColor="#E85D04" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            CornerRadius="14" 
                            HeightRequest="48" />
                </StackLayout>
            </Border>

            <!-- Required Main Ingredients -->
            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{StaticResource NeonGreenTransparent}" 
                    BackgroundColor="{StaticResource CardDark}" Padding="16">
                <StackLayout Spacing="15">
                    <Label Text="Gerekli Ana Malzemeler" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource PrimaryColor}" />
                    
                    <CollectionView ItemsSource="{Binding IngredientsList}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:RecipeIngredientDisplay">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding IconUrl}" FontSize="20" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding DisplayText}" FontSize="16" TextColor="{StaticResource TextLight}" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Border>
            
        </StackLayout>
    </ScrollView>

</ContentPage>
