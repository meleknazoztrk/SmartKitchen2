<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartKitchen.ViewModels"
             xmlns:models="clr-namespace:SmartKitchen.Models"
             x:Class="SmartKitchen.Views.ProfilePage"
             Title="Profilim"
             BackgroundColor="{StaticResource BgDark}">

    <ScrollView>
        <StackLayout Padding="20" Spacing="20">

            <!-- Üst Bar: Kapat + Başlık -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="✕" Command="{Binding CloseCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}"
                        FontSize="22" FontAttributes="Bold"
                        WidthRequest="44" HeightRequest="44" Padding="0" />
                <Label Grid.Column="1" Text="Profilim" FontSize="22" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <!-- Avatar / İsim -->
            <StackLayout HorizontalOptions="Center" Spacing="8" Margin="0,10,0,0">
                <Border StrokeShape="RoundRectangle 50" WidthRequest="90" HeightRequest="90"
                        BackgroundColor="#1A1A1A" Stroke="{DynamicResource PrimaryColor}" StrokeThickness="3"
                        HorizontalOptions="Center">
                    <Label Text="👤" FontSize="44"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="{Binding Username}" FontSize="20" FontAttributes="Bold"
                       TextColor="White" HorizontalOptions="Center" />
            </StackLayout>

            <!-- Bilgi Kartları -->
            <Border StrokeShape="RoundRectangle 16" BackgroundColor="#1C1C1C"
                    Stroke="#2A2A2A" StrokeThickness="1" Padding="20">
                <StackLayout Spacing="16">

                    <!-- Kullanıcı Adı -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="👤" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>
                        <StackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Kullanıcı Adı" FontSize="11" TextColor="{StaticResource TextMuted}" />
                            <Label Text="{Binding Username}" FontSize="16" TextColor="White" FontAttributes="Bold" />
                        </StackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#2A2A2A" />

                    <!-- E-posta -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="📧" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>
                        <StackLayout Grid.Column="1" Spacing="2">
                            <Label Text="E-posta" FontSize="11" TextColor="{StaticResource TextMuted}" />
                            <Label Text="{Binding Email}" FontSize="16" TextColor="White" FontAttributes="Bold" />
                        </StackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#2A2A2A" />

                    <!-- Şifre -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="🔒" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>
                        <StackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Şifre" FontSize="11" TextColor="{StaticResource TextMuted}" />
                            <Label Text="{Binding Password}" FontSize="16" TextColor="White" FontAttributes="Bold" />
                        </StackLayout>
                    </Grid>

                </StackLayout>
            </Border>

            <!-- Tema Seçici -->
            <Label Text="Uygulama Teması" FontSize="18" FontAttributes="Bold"
                   TextColor="White" Margin="0,10,0,0" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <StackLayout Orientation="Horizontal" Spacing="15">
                    <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#00FF88"
                            Command="{Binding ChangeThemeCommand}" CommandParameter="#00FF88" />
                    <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#B200FF"
                            Command="{Binding ChangeThemeCommand}" CommandParameter="#B200FF" />
                    <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#FF007F"
                            Command="{Binding ChangeThemeCommand}" CommandParameter="#FF007F" />
                    <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#FFA500"
                            Command="{Binding ChangeThemeCommand}" CommandParameter="#FFA500" />
                    <Button WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#00BFFF"
                            Command="{Binding ChangeThemeCommand}" CommandParameter="#00BFFF" />
                </StackLayout>
            </ScrollView>

            <!-- Eklediğim Tarifler -->
            <Label Text="Eklediğim Tarifler" FontSize="18" FontAttributes="Bold"
                   TextColor="White" Margin="0,10,0,0" />

            <!-- Tarif yok mesajı -->
            <Label Text="Henüz tarif eklemediniz." FontSize="14"
                   TextColor="{StaticResource TextMuted}"
                   IsVisible="{Binding HasNoRecipes}"
                   HorizontalOptions="Center" Margin="0,10" />

            <!-- Tarifler Listesi -->
            <CollectionView ItemsSource="{Binding MyRecipes}" IsVisible="{Binding HasRecipes}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Recipe">
                        <Border StrokeShape="RoundRectangle 14" BackgroundColor="#1C1C1C"
                                Stroke="{DynamicResource PrimaryColor}" StrokeThickness="1" Padding="15">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource TextMuted}"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="15" Margin="0,4,0,0">
                                        <Label Grid.Column="0" Text="{Binding PrepTimeMinutes, StringFormat='⏱ {0} dk'}"
                                               FontSize="12" TextColor="{StaticResource TextMuted}" />
                                        <Label Grid.Column="1" Text="{Binding Calories, StringFormat='🔥 {0} kcal'}"
                                               FontSize="12" TextColor="{StaticResource TextMuted}" />
                                    </Grid>
                                </StackLayout>
                                <ImageButton Grid.Column="1" BackgroundColor="Transparent" VerticalOptions="Center"
                                             WidthRequest="40" HeightRequest="40" Padding="8"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProfilePageViewModel}}, Path=DeleteRecipeCommand}" CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="🗑️" Color="#FF3B30" Size="24" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Eklediğim Malzemeler -->
            <Label Text="Eklediğim Malzemeler" FontSize="18" FontAttributes="Bold"
                   TextColor="White" Margin="0,10,0,0" />

            <Label Text="Henüz malzeme eklemediniz." FontSize="14"
                   TextColor="{StaticResource TextMuted}"
                   IsVisible="{Binding HasNoIngredients}"
                   HorizontalOptions="Center" Margin="0,10" />

            <CollectionView ItemsSource="{Binding MyIngredients}" IsVisible="{Binding HasIngredients}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Ingredient">
                        <Border StrokeShape="RoundRectangle 14" BackgroundColor="#1C1C1C"
                                Stroke="{DynamicResource PrimaryColor}" StrokeThickness="1" Padding="15">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="{Binding IconUrl}" FontSize="24" VerticalOptions="Center" Margin="0,0,10,0" />
                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="16" TextColor="White" VerticalOptions="Center" />
                                <ImageButton Grid.Column="2" BackgroundColor="Transparent" VerticalOptions="Center"
                                             WidthRequest="40" HeightRequest="40" Padding="8"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProfilePageViewModel}}, Path=DeleteIngredientCommand}" CommandParameter="{Binding .}">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="🗑️" Color="#FF3B30" Size="24" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Çıkış Yap Butonu -->
            <Button Text="Hesaptan Çıkış Yap" Command="{Binding LogoutCommand}"
                    BackgroundColor="#FF3B30" TextColor="White"
                    FontAttributes="Bold" FontSize="16"
                    CornerRadius="14" HeightRequest="52"
                    Margin="0,20,0,40" />

        </StackLayout>
    </ScrollView>

</ContentPage>
