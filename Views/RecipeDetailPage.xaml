<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartKitchen.ViewModels"
             xmlns:models="clr-namespace:SmartKitchen.Models"
             x:Class="SmartKitchen.Views.RecipeDetailPage"
             Title="Pişirme Modu">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20" RowSpacing="20">
            
            <!-- Close Button -->
            <Button Grid.Row="0" Text="X" FontSize="20" WidthRequest="40" HeightRequest="40" 
                    HorizontalOptions="End" VerticalOptions="Start" Padding="0" 
                    BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}"
                    Command="{Binding CloseCommand}" />

            <!-- Title & Description -->
            <StackLayout Grid.Row="1" Spacing="10">
                <Label Text="{Binding Recipe.Title}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="{Binding Recipe.Description}" FontSize="16" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                <StackLayout Orientation="Horizontal" Spacing="15" HorizontalOptions="Center" Margin="0,10,0,0">
                    <Label Text="{Binding Recipe.Calories, StringFormat='🔥 {0} kcal'}" FontSize="14" TextColor="{StaticResource NeonGreen}" />
                    <Label Text="{Binding Recipe.ProteinGrams, StringFormat='💪 {0}g Protein'}" FontSize="14" TextColor="{StaticResource NeonGreen}" />
                </StackLayout>
            </StackLayout>

            <!-- Ingredients -->
            <StackLayout Grid.Row="2" Spacing="15">
                <Label Text="Gerekli Malzemeler" FontSize="20" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding IngredientsList}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:RecipeIngredientDisplay">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                                <Label Grid.Column="0" Text="{Binding IconUrl}" FontSize="18" />
                                <Label Grid.Column="1" Text="{Binding DisplayText}" FontSize="16" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!-- Instructions -->
            <StackLayout Grid.Row="3" Spacing="15">
                <Label Text="Tarifin Yapılışı" FontSize="20" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding Instructions}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                                <Label Grid.Column="0" Text="👉" FontSize="18" />
                                <Label Grid.Column="1" Text="{Binding .}" FontSize="16" LineBreakMode="WordWrap" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>
            
        </Grid>
    </ScrollView>

</ContentPage>
