<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartKitchen.ViewModels"
             x:Class="SmartKitchen.Views.AuthPage"
             Title=""
             BackgroundColor="{StaticResource BgDark}">

    <ScrollView>
        <StackLayout Padding="30" Spacing="0" VerticalOptions="Center">

            <!-- Logo / Başlık -->
            <Label Text="🍽️" FontSize="60" HorizontalOptions="Center" Margin="0,40,0,10" />
            <Label Text="SmartKitchen" FontSize="32" FontAttributes="Bold"
                   TextColor="{StaticResource NeonGreen}" HorizontalOptions="Center" />
            <Label Text="Hesabına giriş yap veya kaydol" FontSize="14"
                   TextColor="{StaticResource TextMuted}" HorizontalOptions="Center"
                   Margin="0,8,0,40" />

            <!-- Tab: Giriş Yap / Kaydol -->
            <Grid ColumnDefinitions="*,*" Margin="0,0,0,30">
                <Button Grid.Column="0" Text="Giriş Yap"
                        Command="{Binding ShowLoginCommand}"
                        BackgroundColor="{StaticResource NeonGreen}" TextColor="Black"
                        FontAttributes="Bold" CornerRadius="12" />
                <Button Grid.Column="1" Text="Kaydol"
                        Command="{Binding ShowRegisterCommand}"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}"
                        CornerRadius="12" BorderColor="{StaticResource NeonGreen}" BorderWidth="1" />
            </Grid>

            <!-- Giriş Yap Formu -->
            <StackLayout IsVisible="{Binding IsLoginVisible}" Spacing="15">
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                        Stroke="{StaticResource NeonGreen}" BackgroundColor="{StaticResource BgCard}">
                    <Entry Placeholder="Kullanıcı Adı" Text="{Binding Username}"
                           PlaceholderColor="{StaticResource TextMuted}"
                           TextColor="White" Margin="15,10" />
                </Border>
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                        Stroke="{StaticResource NeonGreen}" BackgroundColor="{StaticResource BgCard}">
                    <Entry Placeholder="Şifre" Text="{Binding Password}"
                           IsPassword="True" PlaceholderColor="{StaticResource TextMuted}"
                           TextColor="White" Margin="15,10" />
                </Border>
                <Button Text="Giriş Yap" Command="{Binding LoginCommand}"
                        BackgroundColor="{StaticResource NeonGreen}" TextColor="Black"
                        FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Margin="0,10,0,0" />
            </StackLayout>

            <!-- Kaydol Formu -->
            <StackLayout IsVisible="{Binding IsRegisterVisible}" Spacing="15">
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                        Stroke="{StaticResource NeonGreen}" BackgroundColor="{StaticResource BgCard}">
                    <Entry Placeholder="Kullanıcı Adı" Text="{Binding Username}"
                           PlaceholderColor="{StaticResource TextMuted}"
                           TextColor="White" Margin="15,10" />
                </Border>
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                        Stroke="{StaticResource NeonGreen}" BackgroundColor="{StaticResource BgCard}">
                    <Entry Placeholder="E-posta" Text="{Binding Email}"
                           Keyboard="Email" PlaceholderColor="{StaticResource TextMuted}"
                           TextColor="White" Margin="15,10" />
                </Border>
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1"
                        Stroke="{StaticResource NeonGreen}" BackgroundColor="{StaticResource BgCard}">
                    <Entry Placeholder="Şifre" Text="{Binding Password}"
                           IsPassword="True" PlaceholderColor="{StaticResource TextMuted}"
                           TextColor="White" Margin="15,10" />
                </Border>
                <Button Text="Kaydol" Command="{Binding RegisterCommand}"
                        BackgroundColor="{StaticResource NeonGreen}" TextColor="Black"
                        FontAttributes="Bold" CornerRadius="12" HeightRequest="50" Margin="0,10,0,0" />
            </StackLayout>

            <!-- Misafir Devam -->
            <Button Text="Misafir olarak devam et" Command="{Binding ContinueAsGuestCommand}"
                    BackgroundColor="Transparent" TextColor="{StaticResource TextMuted}"
                    FontSize="13" Margin="0,20,0,40" />

        </StackLayout>
    </ScrollView>

</ContentPage>
