<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:SmartKitchen.ViewModels"
             x:Class="SmartKitchen.Views.AddRecipePage"
             Title="Yeni Tarif Ekle"
             BackgroundColor="#121212">

    <Grid>
        <ScrollView Padding="20">
            <VerticalStackLayout Spacing="20">
            
            <Label Text="Kendi Tarifini Yarat" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#FFFFFF" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,10"/>

            <!-- Malzemeler -->
            <Label Text="Malzemeler" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="#FFFFFF" 
                   Margin="0,0,0,0"/>

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Frame Grid.Column="0" 
                       BackgroundColor="#1E1E1E" 
                       CornerRadius="12" 
                       BorderColor="#333333" 
                       Padding="0">
                    <SearchBar Placeholder="Malzeme ara..." 
                               Text="{Binding SearchQuery}" 
                               PlaceholderColor="#888888" 
                               TextColor="#FFFFFF" 
                               CancelButtonColor="{DynamicResource PrimaryColor}"/>
                </Frame>
                <Button Grid.Column="1" 
                        Text="+" 
                        Command="{Binding AddNewIngredientCommand}" 
                        BackgroundColor="{DynamicResource PrimaryColor}" 
                        TextColor="#121212" 
                        FontAttributes="Bold" 
                        FontSize="24" 
                        WidthRequest="50" 
                        HeightRequest="50" 
                        CornerRadius="12"/>
            </Grid>

            <Border BackgroundColor="#1E1E1E" 
                    Stroke="{DynamicResource PrimaryColor}" 
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10" 
                    Padding="10"
                    HeightRequest="250">
                <CollectionView ItemsSource="{Binding Ingredients}" 
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto, Auto, *" Padding="5,10">
                                <CheckBox Grid.Column="0" 
                                          IsChecked="{Binding IsSelected}" 
                                          Color="{DynamicResource PrimaryColor}" 
                                          VerticalOptions="Center"/>
                                <Label Grid.Column="1" 
                                       Text="{Binding Ingredient.IconUrl}" 
                                       FontSize="20" 
                                       VerticalOptions="Center" 
                                       Margin="5,0"/>
                                <Label Grid.Column="2" 
                                       Text="{Binding Ingredient.Name}" 
                                       TextColor="#FFFFFF" 
                                       VerticalOptions="Center" 
                                       FontSize="16" 
                                       LineBreakMode="WordWrap"
                                       Margin="5,0"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- Tarif Adı -->
            <Frame BackgroundColor="#1E1E1E" 
                   CornerRadius="12" 
                   BorderColor="{DynamicResource PrimaryColor}" 
                   Padding="0">
                <Entry Text="{Binding Title}" 
                       Placeholder="Tarif Adı" 
                       PlaceholderColor="#888888" 
                       TextColor="#FFFFFF" 
                       Margin="15,5" 
                       ClearButtonVisibility="WhileEditing"/>
            </Frame>

            <!-- Yapılışı -->
            <Frame BackgroundColor="#1E1E1E" 
                   CornerRadius="12" 
                   BorderColor="#333333" 
                   Padding="0">
                <Editor Text="{Binding Instructions}" 
                        Placeholder="Yapılışı (Her satıra bir adım yazın)" 
                        PlaceholderColor="#888888" 
                        TextColor="#FFFFFF" 
                        HeightRequest="150" 
                        Margin="15,10" 
                        AutoSize="TextChanges"/>
            </Frame>

            <!-- İsteğe Bağlı Değerler (Süre ve Kalori) -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <Frame Grid.Column="0" 
                       BackgroundColor="#1E1E1E" 
                       CornerRadius="12" 
                       BorderColor="#333333" 
                       Padding="0">
                    <Entry Text="{Binding PrepTimeMinutes}" 
                           Placeholder="Süre (Opsiyonel)" 
                           PlaceholderColor="#888888" 
                           TextColor="#FFFFFF" 
                           Keyboard="Numeric" 
                           Margin="15,5"/>
                </Frame>
                <Frame Grid.Column="1" 
                       BackgroundColor="#1E1E1E" 
                       CornerRadius="12" 
                       BorderColor="#333333" 
                       Padding="0">
                    <Entry Text="{Binding Calories}" 
                           Placeholder="Kalori (Opsiyonel)" 
                           PlaceholderColor="#888888" 
                           TextColor="#FFFFFF" 
                           Keyboard="Numeric" 
                           Margin="15,5"/>
                </Frame>
            </Grid>

            <!-- Gizlilik Ayarı -->
            <Frame BackgroundColor="#1E1E1E" 
                   CornerRadius="12" 
                   BorderColor="#333333" 
                   Padding="15,10">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" 
                           Text="Tarifi Herkese Açık Paylaş" 
                           TextColor="#FFFFFF" 
                           VerticalOptions="Center" 
                           FontSize="16"/>
                    <Switch Grid.Column="1" 
                            IsToggled="{Binding IsPublic}" 
                            OnColor="{DynamicResource PrimaryColor}" 
                            ThumbColor="#FFFFFF"/>
                </Grid>
            </Frame>



            <!-- Kaydet Butonu -->
            <Button Text="Tarifi Kaydet" 
                    Command="{Binding SaveRecipeCommand}" 
                    BackgroundColor="{DynamicResource PrimaryColor}" 
                    TextColor="#121212" 
                    FontAttributes="Bold" 
                    FontSize="18" 
                    CornerRadius="12" 
                    HeightRequest="55" 
                    Margin="0,10,0,30"/>

            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsEmojiPickerVisible}" BackgroundColor="#99000000" ZIndex="100">
            <Border BackgroundColor="#1E1E1E" Stroke="{DynamicResource PrimaryColor}" StrokeThickness="2" StrokeShape="RoundRectangle 20" 
                    WidthRequest="320" HeightRequest="450" HorizontalOptions="Center" VerticalOptions="Center" Padding="20">
                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="15">
                    <Label Grid.Row="0" Text="Bir Emoji Seçin" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" />
                    
                    <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableEmojis}" SelectionMode="Single" SelectedItem="{Binding SelectedEmoji}">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="2" StrokeShape="RoundRectangle 10" Padding="0" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" VerticalOptions="Center">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="Stroke" Value="Transparent" />
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="Stroke" Value="{DynamicResource PrimaryColor}" />
                                                    <Setter Property="BackgroundColor" Value="#1100FF88" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label Text="{Binding .}" FontSize="24" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="15">
                        <Button Grid.Column="0" Text="Geç (❓)" Command="{Binding SkipEmojiCommand}" BackgroundColor="#333333" TextColor="#FFFFFF" CornerRadius="10" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="Seç" Command="{Binding ConfirmEmojiCommand}" BackgroundColor="{DynamicResource PrimaryColor}" TextColor="#121212" CornerRadius="10" FontAttributes="Bold" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
